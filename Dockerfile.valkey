# SPDX-License-Identifier: APACHE-2.0

ARG BASE_IMAGE="docker.io/bitnami/minideb:bookworm"

FROM ${BASE_IMAGE}

ARG TARGETARCH
# Injected by the build workflow, read from the vendored sources (valkey/<minor>/debian-12).
# Required: empty values make the component download fail fast. These vary per version
# (e.g. 9.1.2 uses wait-for-port 1.0.11-4 and 7 packages, 8.1.4 uses 1.0.10-1 and 5), so
# they must track the per-version Dockerfile rather than being hardcoded here.
ARG APP_VERSION
ARG WAIT_FOR_PORT_VERSION
ARG PACKAGES

LABEL org.opencontainers.image.base.name="docker.io/bitnami/minideb:bookworm" \
      org.opencontainers.image.title="valkey" \
      org.opencontainers.image.version="${APP_VERSION}"

ENV HOME="/" \
    OS_ARCH="${TARGETARCH:-amd64}" \
    OS_FLAVOUR="debian-12" \
    OS_NAME="linux"

COPY prebuildfs /
SHELL ["/bin/bash", "-o", "errexit", "-o", "nounset", "-o", "pipefail", "-c"]
# Install required system packages and dependencies
RUN install_packages ${PACKAGES}
# Download + checksum-verify + extract the prebuilt Bitnami components. No compile.
# The .sha256 is fetched from the server alongside each tarball rather than read from a
# pre-shipped /opt/bitnami/checksums dir: older releases (e.g. 8.1.x) do not ship that
# dir, so this keeps the build working across every version.
RUN mkdir -p /tmp/bitnami/pkg/cache/ ; cd /tmp/bitnami/pkg/cache/ || exit 1 ; \
    COMPONENTS=( \
      "wait-for-port-${WAIT_FOR_PORT_VERSION}-linux-${OS_ARCH}-debian-12" \
      "valkey-${APP_VERSION}-0-linux-${OS_ARCH}-debian-12" \
    ) ; \
    for COMPONENT in "${COMPONENTS[@]}"; do \
      if [ ! -f "${COMPONENT}.tar.gz" ]; then \
        curl -SsLf "https://downloads.bitnami.com/files/stacksmith/${COMPONENT}.tar.gz" -O ; \
        curl -SsLf "https://downloads.bitnami.com/files/stacksmith/${COMPONENT}.tar.gz.sha256" -O ; \
      fi ; \
      sha256sum -c "${COMPONENT}.tar.gz.sha256" ; \
      tar -zxf "${COMPONENT}.tar.gz" -C /opt/bitnami --strip-components=2 --no-same-owner ; \
      rm -rf "${COMPONENT}.tar.gz" "${COMPONENT}.tar.gz.sha256" ; \
    done ; \
    rm -rf /opt/bitnami/checksums ;
RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && rm -rf /var/lib/apt/lists /var/cache/apt/archives
RUN chmod g+rwX /opt/bitnami
RUN find / -perm /6000 -type f -exec chmod a-s {} \; || true
RUN ln -s /opt/bitnami/scripts/valkey/entrypoint.sh /entrypoint.sh
RUN ln -s /opt/bitnami/scripts/valkey/run.sh /run.sh
RUN uninstall_packages curl

COPY rootfs /
RUN /opt/bitnami/scripts/valkey/postunpack.sh
ENV APP_VERSION="${APP_VERSION}" \
    BITNAMI_APP_NAME="valkey" \
    PATH="/opt/bitnami/common/bin:/opt/bitnami/valkey/bin:$PATH"

EXPOSE 6379

USER 1001
ENTRYPOINT [ "/opt/bitnami/scripts/valkey/entrypoint.sh" ]
CMD [ "/opt/bitnami/scripts/valkey/run.sh" ]
